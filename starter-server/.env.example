# Copy to .env and adjust before running `python manage.py runserver`.

# --- Django ---
DJANGO_ENV=dev
DEBUG=True
SECRET_KEY=django-insecure-dev-key-change-me
JWT_SIGNING_KEY=
NAME_APP=Starter

# --- Database ---
DATABASE_URL=sqlite:///db.sqlite3

# --- Hosts ---
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
FRONTEND_BASE_URL=http://127.0.0.1:4200
PASSWORD_RESET_FRONTEND_PATH_PREFIX=/user/reset-password

# --- Email (console backend prints emails to terminal) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@example.com

# --- Celery (eager mode = run synchronously, no broker needed) ---
CELERY_TASK_ALWAYS_EAGER=True

# --- Upload ---
MEDIA_ROOT_DIR=media

# --- API ---
API_PAGE_SIZE=20

# --- Optional: DeepL translation ---
USE_DEEPL=False
DEEPL_AUTH_KEY=
DEEPL_IS_FREE=True
